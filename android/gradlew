#!/usr/bin/env sh
set -eu
GRADLE_VERSION=8.11.1
DIST_DIR="${GRADLE_USER_HOME:-$HOME/.gradle}/wrapper/dists/manual-gradle-$GRADLE_VERSION"
GRADLE_BIN="$DIST_DIR/gradle-$GRADLE_VERSION/bin/gradle"
if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$DIST_DIR"
  ZIP="$DIST_DIR/gradle.zip"
  curl -fL --retry 3 "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -o "$ZIP"
  unzip -q -o "$ZIP" -d "$DIST_DIR"
  rm -f "$ZIP"
fi
exec "$GRADLE_BIN" "$@"
